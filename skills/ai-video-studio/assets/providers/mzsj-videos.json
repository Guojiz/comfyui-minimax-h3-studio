{
  "id": "mzsj-videos",
  "base_url": "https://mzsjai.com/v1",
  "auth": "bearer",
  "submit": {
    "method": "POST",
    "path": "/videos",
    "fields": ["model", "prompt", "images", "seconds", "size"]
  },
  "poll": {
    "method": "GET",
    "path": "/videos/{task_id}",
    "completed": "completed",
    "failed": "failed"
  },
  "download": {
    "path": "/videos/{task_id}/content",
    "response_fields": ["content_url", "metadata.url"]
  },
  "image_transport": "https-url"
}
